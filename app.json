{
  "expo": {
    "name": "Pace",
    "slug": "pace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#171E19",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171E19"
    },
    "scheme": "exp-tracker",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zerofriction.expensetracker",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "exp-tracker"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171E19"
      },
      "package": "com.sumra.zerofriction",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "exp-tracker",
              "host": "quick-log"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing"
    ],
    "owner": "sumraaa",
    "extra": {
      "eas": {
        "projectId": "a218ac8d-1b29-4e82-82a5-37e444a1a970"
      }
    }
  }
}
